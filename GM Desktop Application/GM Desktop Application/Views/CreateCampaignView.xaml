<UserControl x:Class="GM_Desktop_Application.Views.CreateCampaignView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:GM_Desktop_Application.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">
            <Button AutomationProperties.AutomationId="Create.Back" Content="← _Back to campaigns" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,0,0,24"/>
            <TextBlock Text="New campaign" Style="{StaticResource Heading}"/>
            <TextBlock Text="Give your next story a home." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,28"/>
            <StackPanel IsEnabled="{Binding IsEditable}">
                <Label Content="Campaign _name" Target="{Binding ElementName=CampaignName}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,8"/>
                <TextBox x:Name="CampaignName" AutomationProperties.AutomationId="Create.Name" MaxLength="{x:Static models:CampaignText.NameMaxLength}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Campaign name"/>
                <TextBlock Text="{Binding NameError}" Style="{StaticResource Message}"/>
                <Label Content="_Rules system" Target="{Binding ElementName=SystemChoice}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,8" Margin="0,20,0,0"/>
                <ComboBox x:Name="SystemChoice" AutomationProperties.AutomationId="Create.System" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" TextSearch.TextPath="Name" AutomationProperties.Name="Rules system"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <TextBlock Text="{Binding SystemError}" Style="{StaticResource Message}"/>
                <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolVisibility}}">
                    <Label Content="_System name" Target="{Binding ElementName=SystemName}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,8" Margin="0,20,0,0"/>
                    <TextBox x:Name="SystemName" AutomationProperties.AutomationId="Create.SystemName" MaxLength="{x:Static models:CampaignText.SystemNameMaxLength}" Text="{Binding CustomSystemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="System name"/>
                    <TextBlock Text="{Binding CustomSystemError}" Style="{StaticResource Message}"/>
                    <TextBlock Text="Custom systems support campaign organization. Character sheets and rules assistance are unavailable." Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource Message}"/>
            <TextBlock Text="Saving campaign…" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,8">
                <Button AutomationProperties.AutomationId="Create.Cancel" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,12,0"/>
                <Button AutomationProperties.AutomationId="Create.Save" Content="_Create campaign →" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
